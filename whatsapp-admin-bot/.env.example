# Daftar nomor WhatsApp Owner / Admin yang diizinkan (format internasional tanpa tanda '+', pisahkan dengan koma)
# Contoh: 6281234567890,6289876543210
OWNER_NUMBERS=6287885873325

# Lokasi file kredensial service account Firebase (relatif terhadap root bot atau path absolut)
FIREBASE_SERVICE_ACCOUNT=./serviceAccountKey.json

# URL Firebase Realtime Database Vibetech XYZ
FIREBASE_RTDB_URL=https://vibetech-xyz-default-rtdb.asia-southeast1.firebasedatabase.app

# Nama prefix bot untuk perintah (Default: #)
BOT_PREFIX=#

# Port Opsional (jika ingin menambahkan webhook HTTP di masa mendatang)
PORT=3000
